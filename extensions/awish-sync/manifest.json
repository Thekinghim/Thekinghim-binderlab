{
  "manifest_version": 3,
  "name": "Binderlab · Awish-synk",
  "short_name": "Binderlab Awish",
  "description": "Läser orderlistan i Awish-panelen (dash.awish.vip) med din inloggning och skickar nya ordrar till Binderlab var tionde minut.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_title": "Binderlab Awish-synk",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "offscreen", "scripting"],
  "host_permissions": ["https://dash.awish.vip/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://dash.awish.vip/*"],
      "js": ["discover.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://dash.awish.vip/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
