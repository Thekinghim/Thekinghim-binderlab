# =============================================================================
# Binderlab: miljövariabler. Kopiera till .env.local för lokal utveckling.
# Hemliga värden läggs ALDRIG i repot: i drift ligger de i Vercel (Project →
# Settings → Environment Variables) och i GitHub Environments (migreringar).
# Se docs/miljoer.md. Valideras vid start av src/lib/env.ts.
# =============================================================================

# development | preview | production. Standard lokalt: development.
APP_ENV=development

# Inloggning: dev (bara lokalt) eller supabase. Standard: dev i development,
# annars supabase. dev vägrar starta utanför development och mot en databas
# som inte ligger på localhost/127.0.0.1.
AUTH_PROVIDER=dev

# Appens publika adress utan avslutande snedstreck (länkar i mejl).
# Krävs i production. Lokalt räcker Host-rubriken; i preview används Vercels adress.
# APP_URL=https://app.binderlab.se

# -----------------------------------------------------------------------------
# Databas
# -----------------------------------------------------------------------------
# Lokalt: Postgres 16 med auth-shimmen (npm run db:reset -- dev).
DATABASE_URL=postgres://postgres@127.0.0.1:54322/binderlab_dev
# Databastesterna (npm run test:db) återställer den här databasen vid varje körning.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:54322/binderlab_test
# I drift (Vercel): Supabase-poolern i transaktionsläge, port 6543
# (prepared statements stängs då av automatiskt), t.ex.
# DATABASE_URL=postgresql://postgres.<projekt-ref>:<lösenord>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Antal anslutningar per serverinstans (standard 10; 1–3 räcker på Vercel).
# DATABASE_POOL_MAX=3

# -----------------------------------------------------------------------------
# Dev-inloggning (bara AUTH_PROVIDER=dev)
# -----------------------------------------------------------------------------
# Minst 32 tecken. Skapa med: openssl rand -base64 48
DEV_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Supabase (AUTH_PROVIDER=supabase)
# -----------------------------------------------------------------------------
# Exempel: beställarens projekt. Nycklarna finns i Supabase → Project Settings → API Keys.
# SUPABASE_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co
# Publishable key (sb_publishable_…): får synas i webbläsaren.
# SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): HEMLIG, bara på servern (inbjudningsmejl via admin-API:t).
# Krävs i preview och production.
# SUPABASE_SECRET_KEY=
# JWKS för verifiering av åtkomsttoken. Härleds från SUPABASE_URL om den saknas.
# SUPABASE_JWKS_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co/auth/v1/.well-known/jwks.json

# Samma värden för webbläsaren (bara publika värden i NEXT_PUBLIC_*).
# NEXT_PUBLIC_SUPABASE_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Sentry (felövervakning). Avstängt när DSN saknas.
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://<nyckel>@o<org>.ingest.de.sentry.io/<projekt>
# NEXT_PUBLIC_SENTRY_DSN=https://<nyckel>@o<org>.ingest.de.sentry.io/<projekt>
# Bara vid bygget (källkartor och release). HEMLIG. Sätts i Vercel, aldrig lokalt.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Assistent (/assistent, Claude API). Utan nyckel visar sidan "Assistenten kräver
# ANTHROPIC_API_KEY" och skickar ingenting. Se docs/miljoer.md, avsnittet Assistent.
# -----------------------------------------------------------------------------
# anthropic (standard) eller local (lokal testmodell utan AI, bara APP_ENV=development).
# ASSISTANT_PROVIDER=anthropic
# HEMLIG, bara på servern. Skapas i Claude Console → API Keys.
# ANTHROPIC_API_KEY=
# claude-opus-5-5 (standard) eller claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# -----------------------------------------------------------------------------
# Ekonomi och avtal (/ekonomi, /avtal). Se docs/miljoer.md, avsnittet Ekonomi.
# -----------------------------------------------------------------------------
# Bokföringsprogram för verifikationerna: none (standard, "Ej konfigurerad" +
# SIE-fil), local (skriver SIE-fil till ACCOUNTING_OUTBOX_DIR, bara utveckling),
# fortnox, visma_enet eller bokio (förberedda men inte kopplade än).
# ACCOUNTING_PROVIDER=none
# ACCOUNTING_OUTBOX_DIR=.data/outbox/bokforing
# Utbetalningar från automatleverantören: csv (standard, uppladdning) eller
# awish_api (förberedd, kräver Awish dokumentation för avräkningen).
# PAYOUT_SOURCE=csv
# Avtalsfiler: local (.data/contracts, standard med AUTH_PROVIDER=dev) eller
# supabase (bucket 'contracts', standard annars; kräver SUPABASE_URL och
# SUPABASE_PUBLISHABLE_KEY).
# CONTRACT_FILE_STORE=local
# CONTRACT_FILE_DIR=.data/contracts

# -----------------------------------------------------------------------------
# Drift: larm, push och sms (/drift, /api/cron/larm). Se docs/miljoer.md, Drift.
# E-post för larm använder samma adapter som rapporterna (MAIL_PROVIDER m.fl.).
# -----------------------------------------------------------------------------
# Hemlighet för schemalagda jobb (Vercel Cron skickar Authorization: Bearer <värde>).
# Minst 16 tecken. Utan den körs larmjobbet inte (svarar 503).
# CRON_SECRET=
# Web Push: webpush (riktig, kräver VAPID-nycklar) eller outbox (standard lokalt:
# skriver till .data/outbox/push och skapar lokala nycklar i .data/vapid-dev.json).
# Skapa nycklar: npx web-push generate-vapid-keys
# PUSH_PROVIDER=webpush
# VAPID_PUBLIC_KEY=
# HEMLIG, bara på servern.
# VAPID_PRIVATE_KEY=
# Kontaktadress till den som driver tjänsten (krävs av push-tjänsterna).
# VAPID_SUBJECT=mailto:drift@binderlab.se
# Sms: ingen leverantör vald. outbox (standard lokalt, .data/outbox/sms) eller off.
# SMS_PROVIDER=off
