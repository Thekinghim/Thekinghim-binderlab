# =============================================================================
# Binderlab: miljövariabler. Kopiera till .env.local för lokal utveckling.
# Hemliga värden läggs ALDRIG i repot: i drift ligger de i Vercel (Project →
# Settings → Environment Variables) och i GitHub Environments (migreringar).
# Se docs/miljoer.md. Valideras vid start av src/lib/env.ts.
# =============================================================================

# development | preview | production. Standard lokalt: development.
APP_ENV=development

# Inloggning: dev (bara lokalt) eller supabase. Standard: dev i development,
# annars supabase. dev vägrar starta utanför development och mot en databas
# som inte ligger på localhost/127.0.0.1.
AUTH_PROVIDER=dev

# Appens publika adress utan avslutande snedstreck (länkar i mejl).
# Krävs i production. Lokalt räcker Host-rubriken; i preview används Vercels adress.
# APP_URL=https://app.binderlab.se

# -----------------------------------------------------------------------------
# Databas
# -----------------------------------------------------------------------------
# Lokalt: Postgres 16 med auth-shimmen (npm run db:reset -- dev).
DATABASE_URL=postgres://postgres@127.0.0.1:54322/binderlab_dev
# Databastesterna (npm run test:db) återställer den här databasen vid varje körning.
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:54322/binderlab_test
# I drift (Vercel): Supabase-poolern i transaktionsläge, port 6543
# (prepared statements stängs då av automatiskt), t.ex.
# DATABASE_URL=postgresql://postgres.<projekt-ref>:<lösenord>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
# Antal anslutningar per serverinstans (standard 10; 1–3 räcker på Vercel).
# DATABASE_POOL_MAX=3

# -----------------------------------------------------------------------------
# Dev-inloggning (bara AUTH_PROVIDER=dev)
# -----------------------------------------------------------------------------
# Minst 32 tecken. Skapa med: openssl rand -base64 48
DEV_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Supabase (AUTH_PROVIDER=supabase)
# -----------------------------------------------------------------------------
# Exempel: beställarens projekt. Nycklarna finns i Supabase → Project Settings → API Keys.
# SUPABASE_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co
# Publishable key (sb_publishable_…): får synas i webbläsaren.
# SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): HEMLIG, bara på servern (inbjudningsmejl via admin-API:t).
# Krävs i preview och production.
# SUPABASE_SECRET_KEY=
# JWKS för verifiering av åtkomsttoken. Härleds från SUPABASE_URL om den saknas.
# SUPABASE_JWKS_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co/auth/v1/.well-known/jwks.json

# Samma värden för webbläsaren (bara publika värden i NEXT_PUBLIC_*).
# NEXT_PUBLIC_SUPABASE_URL=https://ukuuwokxbtwhqfnttzwr.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Sentry (felövervakning). Avstängt när DSN saknas.
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://<nyckel>@o<org>.ingest.de.sentry.io/<projekt>
# NEXT_PUBLIC_SENTRY_DSN=https://<nyckel>@o<org>.ingest.de.sentry.io/<projekt>
# Bara vid bygget (källkartor och release). HEMLIG. Sätts i Vercel, aldrig lokalt.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Assistent (/assistent, Claude API). Utan nyckel visar sidan "Assistenten kräver
# ANTHROPIC_API_KEY" och skickar ingenting. Se docs/miljoer.md, avsnittet Assistent.
# -----------------------------------------------------------------------------
# anthropic (standard) eller local (lokal testmodell utan AI, bara APP_ENV=development).
# ASSISTANT_PROVIDER=anthropic
# HEMLIG, bara på servern. Skapas i Claude Console → API Keys.
# ANTHROPIC_API_KEY=
# Modellen för frågorna: claude-opus-5-5 (standard) eller claude-sonnet-5-5.
# (ANTHROPIC_MODEL gäller som äldre namn när ANTHROPIC_MODEL_CHAT saknas.)
# ANTHROPIC_MODEL_CHAT=claude-opus-5-5
# Hur noga modellen tänker: high (standard, ca 1,5–2 kr per fråga), medium eller low.
# ANTHROPIC_EFFORT_CHAT=high

# -----------------------------------------------------------------------------
# Ekonomi och avtal (/ekonomi, /avtal). Se docs/miljoer.md, avsnittet Ekonomi.
# -----------------------------------------------------------------------------
# Bokföringsprogram för verifikationerna: none (standard, "Ej konfigurerad" +
# SIE-fil), local (skriver SIE-fil till ACCOUNTING_OUTBOX_DIR, bara utveckling),
# fortnox, visma_enet eller bokio (förberedda men inte kopplade än).
# ACCOUNTING_PROVIDER=none
# ACCOUNTING_OUTBOX_DIR=.data/outbox/bokforing
# Fortnox (Datakällor → Fortnox): integrationens Client-Id och Client-Secret ur Fortnox
# utvecklarportal. Client-Secret är HEMLIG. Utan dem går Fortnox inte att koppla; inget
# annat påverkas. Token sparas inte här: de ligger i Supabase Vault efter kopplingen.
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
# Standard: {APP_URL}/datakallor/fortnox/klar (samma adress som i utvecklarportalen).
# FORTNOX_REDIRECT_URI=
# Bara test: en falsk Fortnox på den egna datorn (npx tsx scripts/dev/fake-fortnox.ts).
# FORTNOX_API_BASE_URL=http://127.0.0.1:4610
# FORTNOX_AUTH_BASE_URL=http://127.0.0.1:4610
# Utbetalningar från automatleverantören: csv (standard, uppladdning) eller
# awish_api (förberedd, kräver Awish dokumentation för avräkningen).
# PAYOUT_SOURCE=csv
# Den uppladdade utbetalningsfilen sparas som underlag där orderimporten sparar
# sina filer: IMPORT_FILE_STORE (local i development, annars bucket 'imports').
# Avtalsfiler: local (.data/contracts, standard med AUTH_PROVIDER=dev) eller
# supabase (bucket 'contracts', standard annars; kräver SUPABASE_URL och
# SUPABASE_PUBLISHABLE_KEY).
# CONTRACT_FILE_STORE=local
# CONTRACT_FILE_DIR=.data/contracts

# -----------------------------------------------------------------------------
# Drift: larm, push och sms (/drift, /api/cron/larm). Se docs/miljoer.md, Drift.
# E-post för larm använder samma adapter som rapporterna (MAIL_PROVIDER m.fl.).
# -----------------------------------------------------------------------------
# Hemlighet för schemalagda jobb (Vercel Cron och pg_cron skickar Authorization: Bearer <värde>).
# Minst 16 tecken. Utan den körs larmjobbet och Awish-synken inte (svarar 503).
# CRON_SECRET=
# Awish officiella gRPC-API (docs/awish-api.md). Inloggningsuppgifterna sparas i
# Datakällor (Supabase Vault), aldrig här.
# AWISH_GRPC_ADDRESS=49.51.72.74:50051
# Utan TLS (standard, som leverantörens exempel) går appid och token (MD5 av
# AppSecret.AppKey, går aldrig ut) i klartext och kan återanvändas av den som
# avlyssnar, även för skrivande anrop. Sätt true om Awish har TLS; byt AppSecret/
# AppKey vid misstanke. Se docs/awish-api.md, Säkerhet.
# AWISH_GRPC_TLS=false
# Web Push: webpush (riktig, kräver VAPID-nycklar) eller outbox (standard lokalt:
# skriver till .data/outbox/push och skapar lokala nycklar i .data/vapid-dev.json).
# Skapa nycklar: npx web-push generate-vapid-keys
# PUSH_PROVIDER=webpush
# VAPID_PUBLIC_KEY=
# HEMLIG, bara på servern.
# VAPID_PRIVATE_KEY=
# Kontaktadress till den som driver tjänsten (krävs av push-tjänsterna).
# VAPID_SUBJECT=mailto:drift@binderlab.se
# Sms: ingen leverantör vald. outbox (standard lokalt, .data/outbox/sms) eller off.
# SMS_PROVIDER=off

# -----------------------------------------------------------------------------
# Marknad: externa marknadspriser (/marknad). Se docs/marknadskallor.md.
# Ingen extern källa är inkopplad; beställaren väljer källa först.
# -----------------------------------------------------------------------------
# none (standard) eller local (fil i .data, bara utanför production).
# tcgplayer, cardmarket och pricecharting är kandidater utan implementation.
# MARKET_PRICE_SOURCE=none
# Fil för den lokala källan (standard .data/market-prices.json).
# MARKET_PRICE_LOCAL_FILE=.data/market-prices.json

# -----------------------------------------------------------------------------
# Rapporter (/rapporter): e-post, PDF, lagring och månadsutkast. Se docs/miljoer.md.
# -----------------------------------------------------------------------------
# outbox (standard: mejlen skrivs till .data/outbox, inget lämnar servern) eller resend.
# MAIL_PROVIDER=outbox
# Utan riktig e-post (inget MAIL_PROVIDER, resend utan nyckel, eller utkorgen på Vercel) byter
# Rapporter till dela-läget: ägaren delar PDF:en från telefonen och trycker "Ja, skickad".
# Sätt MAIL_PROVIDER=outbox uttryckligen för att prova mejlflödet lokalt (e2e gör det).
# HEMLIG. Resend → API Keys. Krävs när MAIL_PROVIDER=resend.
# RESEND_API_KEY=
# Avsändare på en domän som är verifierad i Resend. Krävs när MAIL_PROVIDER=resend.
# MAIL_FROM=Binderlab <rapporter@binderlab.se>
# MAIL_REPLY_TO=ekonomi@binderlab.se
# Annan mapp för den lokala utkorgen (standard .data/outbox).
# MAIL_OUTBOX_DIR=
# PDF med headless Chromium: local (standard utanför Vercel), sparticuz (standard på Vercel) eller off.
# PDF_RENDERER=local
# Chromium för local (standard: Playwrights i /opt/pw-browsers eller PLAYWRIGHT_BROWSERS_PATH).
# PDF_CHROMIUM_PATH=
# Adress som Chromium öppnar rapportsidan på, om den publika adressen inte nås inifrån servern.
# REPORT_RENDER_URL=http://127.0.0.1:3000
# Lagring av PDF: local (standard i development, .data/reports) eller supabase (bucket "reports").
# REPORT_STORAGE=local
# REPORT_STORAGE_DIR=
# SIE 4 i bokföringsunderlaget: verifikationsserie (standard A) och första nummer i
# räkenskapsåret (standard 1). Numreringen fortsätter sedan från förra månadens godkända
# underlag. Bestäm serien med bokhållaren (serie A används ofta för manuella poster).
# REPORT_SIE_SERIES=A
# REPORT_SIE_FIRST_NUMBER=1
# CRON_SECRET (ovan) skyddar också /api/cron/rapporter: utkast för förra månaden den 1:a
# varje månad (vercel.json).

# -----------------------------------------------------------------------------
# Driftsättning (scripts/deploy, docs/driftsattning.md). Sätts i sessionen som
# driftsätter, ALDRIG i Vercel eller i .env.local. Skripten läser inte .env.local.
# -----------------------------------------------------------------------------
# HEMLIG. Supabase → Account → Access Tokens (Owner/Administrator i organisationen).
# SUPABASE_ACCESS_TOKEN=
# HEMLIG. Vercel → Account Settings → Tokens (scope: teamet).
# VERCEL_TOKEN=
# Valfritt: Vercel-team (id eller slug) och Supabase-organisation för produktionsprojektet.
# VERCEL_TEAM_ID=
# SUPABASE_ORG_ID=
# Valfritt: appens adress i produktion (samma som --app-url). Standard: Vercels domän.
# BINDERLAB_APP_URL=https://app.binderlab.se
# Valfritt, HEMLIG: utvecklingsprojektets databaslösenord. Ger Vercel Preview en
# DATABASE_URL. Utan det sätts ingen (lösenordet byts bara med --byt-dev-losenord).
# SUPABASE_DEV_DB_PASSWORD=
# Sätts av skripten i Vercel, aldrig för hand: fingeravtryck (sha256-prefix) av
# känsliga värden, vart DATABASE_URL pekar (<ref>@<pooler>) och om en driftsättning väntar.
# BINDERLAB_DEPLOY_STATE=
# Egen testdatabas för test/deploy/migrations.db.test.ts (raderas vid varje körning).
# DEPLOY_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54322/binderlab_test_driftsattning
